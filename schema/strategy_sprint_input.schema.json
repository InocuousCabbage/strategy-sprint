{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/InocuousCabbage/strategy-sprint/schema/strategy_sprint_input.schema.json",
  "title": "Strategy Sprint machine-readable output",
  "description": "The typed contract between a Strategy Sprint run and any program that consumes it. Each exercise writes a human markdown section AND a machine sidecar; this schema governs the sidecars and the run manifest that indexes them. ENVELOPE ONLY at this version: per-exercise payload shapes land additively under $defs/payloads and cannot break a consumer written against the envelope.",
  "$comment": "Version 0.1.0, 2026-08-05. Envelope is stable; payloads are not yet defined.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/sidecar"
    }
  ],
  "$defs": {
    "exerciseId": {
      "description": "Stable identifier for a sprint step. Matches the skill directory name so the id, the slash command, and the sidecar filename never drift apart.",
      "enum": [
        "company-overview",
        "icp-prioritization",
        "marketing-advantages",
        "perceptions",
        "positioning",
        "revenue-levers",
        "channel-strategy",
        "big-bets",
        "brand-voice",
        "tool-inventory"
      ]
    },
    "completionStatus": {
      "description": "Operator-visible state of one step. Load-bearing: a missing sidecar alone is ambiguous between never-ran, ran-and-failed-to-write, and wrote-to-the-wrong-path, and those want different remediation. Recording status OUTSIDE the sidecar is what makes them separable.",
      "enum": [
        "unrun",
        "complete",
        "failed"
      ]
    },
    "manifest": {
      "type": "object",
      "description": "Written to ${ARTIFACT_DIR}/output/sprint-manifest.yaml. THE ENTRY POINT: a consumer reads this first, then resolves sidecars from it. It exists because completion status cannot live only in the sidecar. A sidecar that is missing cannot tell you it was expected, so 'complete but absent' would be indistinguishable from 'never ran' and the three-way distinction would collapse back to two. The manifest is the thing that survives a sidecar that was never written.",
      "required": [
        "schemaVersion",
        "clientSlug",
        "generatedAt",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "clientSlug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Matches the artifacts/<client-slug>/ directory name."
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sprintComplete": {
          "type": "boolean",
          "description": "True only when every step with required=true has status 'complete'. Denormalized on purpose so a consumer can reject an unfinished run without walking the step list."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per sprint step, in execution order. Present for EVERY step including unrun ones: an absent entry means the manifest is stale, which is itself a defect worth raising rather than silently treating as unrun.",
          "items": {
            "$ref": "#/$defs/manifestStep"
          }
        }
      }
    },
    "manifestStep": {
      "type": "object",
      "required": [
        "exerciseId",
        "order",
        "status",
        "sidecarPath"
      ],
      "additionalProperties": false,
      "properties": {
        "exerciseId": {
          "$ref": "#/$defs/exerciseId"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Execution position. Exercises 1-8 are the numbered sprint; companions (brand-voice) and prerequisites (tool-inventory) carry an order too so a consumer can sort one list."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "False for optional steps. An optional step left unrun does not make the sprint incomplete."
        },
        "status": {
          "$ref": "#/$defs/completionStatus"
        },
        "sidecarPath": {
          "type": "string",
          "description": "Path relative to ${ARTIFACT_DIR}, e.g. output/positioning.yaml. Recorded rather than derived so a consumer never has to reconstruct a filename convention, and so a step that legitimately writes somewhere else stays loadable.",
          "pattern": "^output/[a-z0-9-]+\\.yaml$"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Null unless status is 'complete'."
        },
        "failureReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when status is 'failed'. Free text for a human; a consumer should surface it rather than parse it."
        }
      },
      "allOf": [
        {
          "$comment": "A failed step must say why. A status with no diagnosis pushes the investigation onto whoever finds it later, which is the expensive moment.",
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "failureReason"
            ],
            "properties": {
              "failureReason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "$comment": "An unrun step has nothing to timestamp. Guarding this direction too, so a stale completedAt cannot survive a re-set to unrun.",
          "if": {
            "properties": {
              "status": {
                "const": "unrun"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "completedAt": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "sidecar": {
      "type": "object",
      "description": "Written to ${ARTIFACT_DIR}/output/<exercise-id>.yaml by each exercise alongside its markdown section. Header is fixed; payload is open at this schema version.",
      "required": [
        "schemaVersion",
        "exerciseId",
        "generatedAt",
        "confirmedByClient",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "exerciseId": {
          "$ref": "#/$defs/exerciseId"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "clientSlug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sourceSection": {
          "type": "string",
          "description": "The heading in marketing-strategy.md this sidecar mirrors, e.g. '## Channel Strategy'. Lets a consumer point a human at the prose behind a machine value."
        },
        "confirmedByClient": {
          "type": "boolean",
          "description": "Every exercise pauses for client confirmation before saving. False means drafted but not confirmed, a legitimate intermediate state that is NOT the same as complete. REQUIRED, not optional: a consumer that rejects unconfirmed content cannot treat an absent field as a safe default, because absent would be ambiguous between not-confirmed and exercise-never-recorded-it. That is the same ambiguity the manifest exists to break, one field over, so it is closed the same way: by making the producer state it."
        },
        "payload": {
          "type": "object",
          "description": "Exercise-specific content. OPEN at schema version 0.1.0: no properties are constrained yet. Per-exercise definitions land under $defs/payloads and are attached here by a future conditional block. Because this starts open and closes later, a consumer written against the envelope today keeps working: added payload constraints reject malformed NEW data, they do not change the envelope's shape.",
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "company-overview"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/company-overview"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "icp-prioritization"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/icp-prioritization"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "marketing-advantages"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/marketing-advantages"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "perceptions"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/perceptions"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "positioning"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/positioning"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "revenue-levers"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/revenue-levers"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "channel-strategy"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/channel-strategy"
              }
            }
          }
        },
        {
          "$comment": "Attach a payload schema once one exists. An exercise with no definition keeps the open payload from 0.1.0.",
          "if": {
            "properties": {
              "exerciseId": {
                "const": "big-bets"
              }
            },
            "required": [
              "exerciseId"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/payloads/big-bets"
              }
            }
          }
        }
      ]
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of THIS schema, not of the sprint. A consumer should reject a major it does not know rather than guess."
    },
    "payloads": {
      "$comment": "One definition per exercise, attached to sidecar.payload by the conditional in $defs/sidecar/allOf. Landing them additively is why the envelope shipped first. PATTERN, follow it for the remaining seven: derive fields from that exercise's own 'Step 3: Document' output block, keep every field OPTIONAL except the one or two the exercise exists to produce, and allow null with a stated reason rather than forcing a value the client did not give. A schema that forces completeness turns 'they would not tell us' into a fabricated number.",
      "company-overview": {
        "type": "object",
        "description": "Exercise 1. Mirrors the Company Snapshot, Key Metrics, Key Differentiators, Recent Momentum, Current Challenges and Competitive Landscape blocks.",
        "required": [
          "company",
          "differentiators"
        ],
        "additionalProperties": false,
        "properties": {
          "company": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "industry": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Added 2026-08-05. The GTM generator requires an industry and no exercise produced one, so every plan run failed on a field nothing could supply. Stated here rather than inferred downstream from businessModel or companyType free text: a derived industry wearing the same type as a stated one is indistinguishable by the time anything consumes it."
              },
              "founded": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1800
              },
              "stage": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "teamSize": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "businessModel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pricing": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Free text. Pricing structures do not reduce to a number and forcing one loses the structure."
              }
            }
          },
          "productOverview": {
            "type": [
              "string",
              "null"
            ],
            "description": "The 2-3 paragraph prose block, carried verbatim. Not decomposed: it is written for a human and any split would be this schema inventing structure the exercise never asked for."
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "description": "Every metric is optional AND nullable. A client who will not share ARR is the normal case, and a schema that forces the field invites an estimate presented as a figure.",
            "properties": {
              "arr": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mrr": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{3}$"
              },
              "customers": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "growthRatePct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "nrrPct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cac": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ltv": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "monthlyOpex": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "notProvided": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Metric names the client declined or could not supply. EXPLICIT, because a null field alone cannot say whether it was asked. Same reason the run manifest exists."
              }
            }
          },
          "differentiators": {
            "type": "array",
            "minItems": 1,
            "description": "The exercise exists to produce these, so at least one is required.",
            "items": {
              "type": "object",
              "required": [
                "claim"
              ],
              "additionalProperties": false,
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The skill asks for evidence per differentiator. Nullable so an unevidenced claim is recorded AS unevidenced rather than dropped or invented."
                }
              }
            }
          },
          "recentMomentum": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentChallenges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "competitors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "howTheyDiffer": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "icp-prioritization": {
        "type": "object",
        "description": "Exercise 2. Priority matrix plus optional per-segment deep dives.",
        "required": [
          "tiers"
        ],
        "additionalProperties": false,
        "properties": {
          "tamOverview": {
            "type": [
              "string",
              "null"
            ],
            "description": "Prose. Not decomposed."
          },
          "industries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Added 2026-08-05, for the same reason as company.industry. The GTM generator requires at least one target-market industry. tamOverview is the nearest existing field and is deliberately undecomposed prose, so satisfying the requirement from it would mean parsing an industry list out of a paragraph. That is inference presented as a stated value. Optional: an exercise that did not establish industries records none rather than producing some."
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "description": "The exercise exists to produce this ranking.",
            "items": {
              "type": "object",
              "required": [
                "priority",
                "segment"
              ],
              "additionalProperties": false,
              "properties": {
                "priority": {
                  "enum": [
                    "Core",
                    "Scaling",
                    "Testing",
                    "Not a Priority"
                  ]
                },
                "segment": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "companyType": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "resourceAllocationPct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Null for Not a Priority, which allocates nothing by definition."
                },
                "maturity": {
                  "enum": [
                    "Proven",
                    "Growing",
                    "New",
                    null
                  ]
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "segmentDeepDives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "segment"
              ],
              "additionalProperties": false,
              "properties": {
                "segment": {
                  "type": "string",
                  "minLength": 1
                },
                "painPoints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "purchaseTriggers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "decisionCriteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "buyingProcess": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "whereTheyGather": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "marketing-advantages": {
        "type": "object",
        "description": "Exercise 3. Assessment across categories, then a prioritized top three.",
        "required": [
          "topPriorities"
        ],
        "additionalProperties": false,
        "properties": {
          "assessment": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "advantage"
              ],
              "additionalProperties": false,
              "properties": {
                "advantage": {
                  "type": "string",
                  "minLength": 1
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "strength": {
                  "enum": [
                    "Strong",
                    "Moderate",
                    "Weak",
                    "None",
                    null
                  ]
                },
                "differentiation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accelerationStrategy": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "topPriorities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "description": "The exercise exists to produce these. Capped at three because the skill asks for a top three; a longer list is a failure to prioritize.",
            "items": {
              "type": "object",
              "required": [
                "advantage",
                "rationale"
              ],
              "additionalProperties": false,
              "properties": {
                "advantage": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "toDevelop": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "6-12 month horizon."
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "perceptions": {
        "type": "object",
        "description": "Exercise 4. Storylines the client wants believed, with proof and content mapping.",
        "required": [
          "perceptions"
        ],
        "additionalProperties": false,
        "properties": {
          "perceptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "label",
                "whyItMatters"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "whyItMatters": {
                  "type": "string",
                  "minLength": 1
                },
                "currentState": {
                  "enum": [
                    "believed",
                    "partially believed",
                    "not believed",
                    "unknown",
                    null
                  ],
                  "description": "unknown is distinct from not-believed: one is a measured absence of belief, the other is an unmeasured question."
                },
                "proofPoints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "contentPillars": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "priority": {
                  "enum": [
                    "Primary",
                    "Secondary",
                    null
                  ]
                },
                "firstCampaign": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "positioning": {
        "type": "object",
        "description": "Exercise 5. Positioning statement, category strategy, competitive map, win/loss.",
        "required": [
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Carried verbatim. The exercise exists to produce this one sentence."
          },
          "fourQuestions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "question"
              ],
              "additionalProperties": false,
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "today": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "SELF-DESCRIPTION, not world-state. Holds how the company currently POSITIONS itself, per the exercise question 'How would you describe your positioning today'. The answers are the company's own claims (current category/framing, current key benefit, current proof points), NOT observations about the market. Do not audit external artifacts such as site copy against this field: the copy is one expression of the same positioning, so the check is circular. 'today' is a SOURCE qualifier that reads like a TIME qualifier."
                },
                "inTwelveMonths": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "SELF-DESCRIPTION of an intended future position, not a forecast about the world. Same source-qualifier caveat as 'today'."
                }
              }
            }
          },
          "categoryStrategy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "approach": {
                "enum": [
                  "existing category",
                  "subcategory",
